# =============================================================================
# SiliconPulse - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Core Application
# -----------------------------------------------------------------------------
# Google Gemini API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Authentication (Get from https://dashboard.clerk.com)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=your-clerk-audience
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# -----------------------------------------------------------------------------
# REQUIRED - Database & Persistence (Supabase)
# -----------------------------------------------------------------------------
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: anon key for per-user RLS (if you expose Supabase to the client)
# SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# OPTIONAL - External News APIs (Free tiers available)
# -----------------------------------------------------------------------------
# NewsAPI.org (Get from https://newsapi.org/register)
NEWSAPI_API_KEY=your_newsapi_key
# YouTube Data API v3 (for Intelligence Videos — Get from https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL - Frontend Configuration
# -----------------------------------------------------------------------------
# Backend API URL (Change for production)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Frontend Gemini Key (Only needed if using direct frontend Gemini - currently unused)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL - Backend Tuning
# -----------------------------------------------------------------------------
# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Data Stream
DATA_STREAM_PATH=data/stream.jsonl
DB_PATH=data/siliconpulse.db

# Freshness & Scanning
FRESHNESS_HOURS=12
MAX_EVENTS_TO_SCAN=500

# Deduplication & Checkpoints
DEDUP_ENABLED=true
CHECKPOINT_ENABLED=true

# Optional local JSONL cache when Supabase is configured (never used in production)
LOCAL_CACHE_ENABLED=false

# Source catch-up window when no persisted checkpoint exists
INGESTION_LOOKBACK_HOURS=72

# Free Data Sources
GDELT_ENABLED=True
HACKERNEWS_ENABLED=True

# Model Selection
GEMINI_MODEL=gemini-1.5-flash

# Distributed workers (1M+ events/day)
# WORKER_COUNT=4  # per-instance workers (1-16); also via REDIS_URL auto-enables
# SHARD_COUNT=4
# SHARD_ID=0

# Redis (required for the production scheduler worker; Compose provisions Redis locally)
# REDIS_URL=redis://default:password@redis:6379/0

# Scheduled digest delivery (Resend email + Slack/Discord webhook)
# RESEND_API_KEY=re_your_resend_key
# RESEND_FROM_EMAIL=SiliconPulse <onboarding@resend.dev>
